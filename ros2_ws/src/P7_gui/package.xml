<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>P7_gui</name>
  <version>0.0.0</version>
  <description>Operator GUI for the P7 drone stack: launch the system, start/finish frontier exploration, mission timer and a 2D (x, y) flight heatmap with PNG export.</description>
  <maintainer email="rdkr23@student.aau.dk">rasmus</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>frontier_viewpoint_optimizer</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>P7_topdown_map</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
