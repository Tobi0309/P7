<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>P7_topdown_map</name>
  <version>0.0.0</version>
  <description>Projects the camera-filtered octomap to a 2D top-down map (explored area, floor via the DSP floor method, trees) and accumulates a 2D camera-coverage map from the camera-filtered LiDAR cloud.</description>
  <maintainer email="rdkr23@student.aau.dk">rasmus</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>octomap</depend>
  <depend>octomap_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
