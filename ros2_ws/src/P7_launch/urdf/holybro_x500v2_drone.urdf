<?xml version="1.0"?>
<robot name="drone">

  <material name="drone_blue">
    <color rgba="0.1 0.3 1.0 1.0"/>
  </material>

  <!-- IMU-propagated reference frame -->
  <link name="body_imu"/>

  <!-- Aircraft geometric centre -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://P7_launch/meshes/holybro_x500v2_drone_upd.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="drone_blue"/>
    </visual>
  </link>

  <!-- IMU frame to aircraft geometric centre -->
  <joint name="base_link_joint" type="fixed">
    <parent link="body_imu"/>
    <child link="base_link"/>
    <origin xyz="-0.011 -0.06863 -0.01721"
            rpy="3.141592653589 -0.392699082 1.57079633"/>
  </joint>

  <!-- LiDAR receiver frame -->
  <link name="lidar_receiver"/>

  <!-- Aircraft geometric centre to LiDAR receiver -->
  <joint name="lidar_receiver_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_receiver"/>
    <origin xyz="0.065358673 0.0 -0.039310665"
            rpy="2.748893572 0.0 1.570796330"/>
  </joint>

  <!-- RealSense camera -->
  <link name="camera_link"/>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.12821 0.0 0.01501"
            rpy="0 0 0"/>
  </joint>

</robot>
